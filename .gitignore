# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo
*.js.map

# elizaOS runtime
.eliza/
.elizadb/

# Environment — never commit secrets
.env
.env.local
.env.*.local

# Runtime state (gitignored; .gitkeep placeholders track the dirs)
content-queue/pending/**
content-queue/approved/**
content-queue/rejected/**
content-queue/published/**
!content-queue/**/.gitkeep
ops/status.json
ops/paused.json
ops/usage.json

# Media (can be large)
media/source/**
!media/source/.gitkeep
media/clips/**
!media/clips/.gitkeep

# Agent feedback / learning
knowledge/feedback/*.md
!knowledge/feedback/.gitkeep

# WhatsApp auth state
.eliza/whatsapp-auth/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Coverage
coverage/
.nyc_output/

# Cache
.cache/
.turbo/
.eslintcache
.stylelintcache

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Cypress
cypress/videos/
cypress/screenshots/

# Bun
.bun/
bun.lockb

# Misc
*.tgz
*.tar.gz
